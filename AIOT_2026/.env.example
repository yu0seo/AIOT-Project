# 영상 수집기에 필수: Supabase 프로젝트 URL / 서버 전용 Secret key
# 로컬 결과만 보는 serve_results.py에는 Supabase 키가 필요 없음
# SUPABASE_SECRET_KEY에는 sb_secret_... 또는 legacy service_role 키 중 하나만 입력
# anon / publishable 키, DB 비밀번호, Personal Access Token은 사용하지 않음
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 기존 인수인계의 Storage 설정. 현재 프로젝트와 일치하는지 확인
STORAGE_BUCKET=breathing-video
STORAGE_PREFIX=pi-camera/b68d088e-e0d0-4606-a21e-8e2a8099dda3

# 이 수집 세션의 결과 구분명. 업로더 번호 초기화 시 새 prefix/이름/WORK_DIR 사용
STREAM_ID=babycam-session-1
# auto = 최초 시작 때 가장 오래된 TS부터. 특정 번호부터는 예: 210
START_SEQ=auto

AIR400_ROOT=.
WORK_DIR=output/stream_batches
# 판단 결과는 이 로컬 폴더에 저장. Supabase 결과 테이블/SQL은 필요 없음
RESULT_DIR=output/stream_results
FFMPEG=ffmpeg
FFPROBE=ffprobe
POLL_SECONDS=2
RESULT_POLL_SECONDS=2
SERVER_PORT=8766
